      "tested_use": { "text": "Tried in two classes.", "written_by": ["author_b"], "approved_by": ["author_a", "author_b"], "drafted_by_assistant": false },
      "risks": { "text": "Not for assessment.", "written_by": ["author_a", "author_b"], "approved_by": ["author_b"], "drafted_by_assistant": false }
    }
  },
