    "schema": "passport/1",
    "plugin": { "id": "elm/pedagogy", "version": "1.0.0" },
    "covers": [
      { "version": "1.0.0", "content_hash": "sha256:1111111111111111111111111111111111111111111111111111111111111111" }
    ],
    "authors": [
      { "id": "author_a", "name": "Ada Teacher" },
      { "id": "author_b", "name": "Ben Teacher" }
    ],
    "issuer": null,
