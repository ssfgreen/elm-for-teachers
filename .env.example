# Database. A local libsql/SQLite file (relative paths resolve against the repo root; ./data is created).
DATABASE_URL=file:./data/edw.db
# Alternative: a hosted Turso database. Comment out the file URL above and use these two lines.
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token
# Model provider: "mock" (no key needed, canned outputs) or "elm" (real model via the ELM proxy).
PROVIDER=mock
# Base URL of the ELM proxy (required when PROVIDER=elm).
ELM_PROXY_BASE_URL=https://elm.edina.ac.uk/api/v1
# API key for the ELM proxy (required when PROVIDER=elm).
ELM_PROXY_API_KEY=
# Chat completions path appended to ELM_PROXY_BASE_URL.
ELM_PROXY_CHAT_PATH=/chat/completions
# Responses API path, used in agent mode (config/app.config.json "mode": "agent").
ELM_PROXY_RESPONSES_PATH=/responses
# Password for /admin outside production: locally (Docker, e2e) and on a Vercel preview (set it for
# Preview, branch development only); refused in Vercel production and with DEPLOY_ENV=production,
# where admins sign in with Google or
# Microsoft (DEPLOY.md section 12). Left empty, no password works. CONSOLE_PASSWORD, the old name, is still read.
ADMIN_PASSWORD=
# Where this server runs: production, preview or local (the default). In production the admin
# password is refused and need not be set. Ignored on Vercel, which says itself.
# DEPLOY_ENV=local
# Port the server listens on.
PORT=3000
# Interface the server binds to.
HOST=0.0.0.0
# Directory holding app.config.json and system_prompt.md (default: <repo>/config).
# CONFIG_DIR=
# Tool version recorded in every export bundle.
TOOL_VERSION=0.1.0
# Run migrations when the server starts (the default, as on Vercel). Set false where they run as
# their own step first: node packages/server/dist/migrate.js (a Kubernetes Job before each rollout).
# MIGRATE_ON_START=true
# Take the visitor's address from X-Forwarded-For: only behind a proxy that replaces any
# X-Forwarded-For the visitor sent (one that appends or passes it through lets them pick their address).
# Default: on on Vercel, off elsewhere.
# TRUST_PROXY=false
# How long a request may run before the platform stops it, in ms (Vercel's maxDuration, an ingress timeout).
# FUNCTION_LIMIT_MS=300000
# Public origin used to build workspace links (/s/:token).
# PUBLIC_BASE_URL=http://localhost:3000   (optional: links follow the admin page origin when unset)
# Image storage in an S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2). Optional on a
# server, needed on Vercel for images over about 3 MB. Set all four, or none to keep images in the database.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=worksheet-images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# The library server (library/: curriculum, pedagogy, E&Os, TRAILS). Run it with
# `pnpm --filter @edw/library serve` (port 8787). Without it, libraries, the curriculum picker
# and the pedagogy library show as not set up.
LIBRARY_URL=http://localhost:8787
# On Vercel the library runs beside the app at https://<your-domain>/library and refuses any
# request without this token. Set it on the project (Production and Preview) and leave
# LIBRARY_URL unset there: each deployment finds its own library (DEPLOY.md, section 6).
# Not needed locally.
# LIBRARY_TOKEN=

# The plugin studio (ssfgreen/education-plugin-studio): a workspace may add a draft only from
# this address (several separated by commas; https, or http for localhost). Unset, drafts are off.
# PLUGIN_STUDIO_URL=http://localhost:3000

# Teacher sign-in with Google or Microsoft (DEPLOY.md, section 12). Optional: a provider with no
# client id and secret is not offered. Callbacks go to PUBLIC_BASE_URL, else (locally)
# http://localhost:PORT, at /api/auth/<google|microsoft>/callback.
# AUTH_SECRET=                      (openssl rand -base64 32; required with any provider)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
#   (AUTH_MICROSOFT_CLIENT_ID and AUTH_MICROSOFT_CLIENT_SECRET are the old, deprecated names: still
#   read, but only when neither new name is set. Rename them.)
# AUTH_MICROSOFT_TENANT=organizations   (or your directory (tenant) ID)
# Optional open doors, comma-separated: people here may sign in without an invite.
# AUTH_OPEN_MICROSOFT_TENANTS=
# AUTH_OPEN_GOOGLE_DOMAINS=

# Pupils sign in on /r with the same Google and Microsoft apps (issue #179). Add these redirect
# addresses to each app: <site>/api/pupil/auth/google/callback and
# <site>/api/pupil/auth/microsoft/callback. Pupil sign-in is on only with PUPILS=on: unset or
# off, every pupil route is shut and the landing page shows no pupils' link. Left off here, so a
# site set up from this file keeps pupils out: uncomment it for local development, and set it on a
# real site only to try pupil sign-in (DEPLOY.md, section 12).
# PUPILS=on

# Kubernetes and compose.yaml only (DEPLOY.md, section 13): where Litestream copies the database.
# University storage, S3-compatible; never the S3_* file bucket above (refused if it is).
# BACKUP_S3_ENDPOINT=https://s3.example.ed.ac.uk
# BACKUP_S3_BUCKET=edw-db-backups
# BACKUP_S3_PATH=edw
# BACKUP_S3_REGION=us-east-1
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Jobs (slow work outside a request; nothing uses them yet). On Vercel its cron calls
# /api/jobs/run with this as a bearer token (DEPLOY.md, section 6); unset, the route refuses every
# call. At least 16 characters: openssl rand -base64 24. Not needed locally, where
# `node packages/server/dist/worker.js` runs the jobs instead.
# CRON_SECRET=
