{
  "name": "epistemic-differentiation-workshop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/file-sizes.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @edw/shared build && pnpm -r typecheck",
    "format": "prettier --write .",
    "dev:server": "pnpm --filter @edw/server dev",
    "dev:client": "pnpm --filter @edw/client dev",
    "eval": "pnpm --filter @edw/evals eval",
    "sizes": "node scripts/file-sizes.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
