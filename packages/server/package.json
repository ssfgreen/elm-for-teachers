{
  "name": "@edw/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/db/migrations && cp -r src/db/migrations dist/db/",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@edw/shared": "workspace:*",
    "@fastify/static": "^7.0.4",
    "@libsql/client": "^0.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jszip": "^3.10.1",
    "openid-client": "^6.8.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
